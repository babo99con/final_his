FROM node:24-bookworm-slim AS deps

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:24-bookworm-slim AS build

WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_AUTH_API_BASE_URL=http://localhost:8586
ARG NEXT_PUBLIC_MENU_API_BASE_URL=http://localhost:8586
ARG NEXT_PUBLIC_NOTIFICATION_API_BASE_URL=http://localhost:8586
ARG NEXT_PUBLIC_BILLING_API_BASE_URL=http://localhost:8081
ARG NEXT_PUBLIC_STAFF_API_BASE_URL=http://localhost:8023
ARG NEXT_PUBLIC_PATIENTS_API_BASE_URL=http://localhost:8182
ARG NEXT_PUBLIC_RECEPTION_API_BASE_URL=http://localhost:8283
ARG NEXT_PUBLIC_RECEPTION_FALLBACK_BASE_URL=http://localhost:8283
ARG NEXT_PUBLIC_CLINICAL_API_BASE_URL=http://localhost:8090
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8090
ARG NEXT_PUBLIC_NURSING_API_BASE_URL=http://localhost:8189
ARG NEXT_PUBLIC_MEDICAL_SUPPORT_RECORD_API_BASE_URL=http://localhost:8189
ARG NEXT_PUBLIC_API_BASE=http://localhost:8283
ARG NEXT_PUBLIC_TOSS_CLIENT_KEY

ARG AUTH_API_INTERNAL_URL=http://auth-service:8586
ARG PATIENTS_API_INTERNAL_URL=http://patient-service:8182
ARG RECEPTION_API_INTERNAL_URL=http://reception-service:8283
ARG BILLING_API_INTERNAL_URL=http://billing-service:8081
ARG NOTIFICATION_API_INTERNAL_URL=http://auth-service:8586

ENV NEXT_PUBLIC_AUTH_API_BASE_URL=${NEXT_PUBLIC_AUTH_API_BASE_URL}
ENV NEXT_PUBLIC_MENU_API_BASE_URL=${NEXT_PUBLIC_MENU_API_BASE_URL}
ENV NEXT_PUBLIC_NOTIFICATION_API_BASE_URL=${NEXT_PUBLIC_NOTIFICATION_API_BASE_URL}
ENV NEXT_PUBLIC_BILLING_API_BASE_URL=${NEXT_PUBLIC_BILLING_API_BASE_URL}
ENV NEXT_PUBLIC_STAFF_API_BASE_URL=${NEXT_PUBLIC_STAFF_API_BASE_URL}
ENV NEXT_PUBLIC_PATIENTS_API_BASE_URL=${NEXT_PUBLIC_PATIENTS_API_BASE_URL}
ENV NEXT_PUBLIC_RECEPTION_API_BASE_URL=${NEXT_PUBLIC_RECEPTION_API_BASE_URL}
ENV NEXT_PUBLIC_RECEPTION_FALLBACK_BASE_URL=${NEXT_PUBLIC_RECEPTION_FALLBACK_BASE_URL}
ENV NEXT_PUBLIC_CLINICAL_API_BASE_URL=${NEXT_PUBLIC_CLINICAL_API_BASE_URL}
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_NURSING_API_BASE_URL=${NEXT_PUBLIC_NURSING_API_BASE_URL}
ENV NEXT_PUBLIC_MEDICAL_SUPPORT_RECORD_API_BASE_URL=${NEXT_PUBLIC_MEDICAL_SUPPORT_RECORD_API_BASE_URL}
ENV NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE}
ENV NEXT_PUBLIC_TOSS_CLIENT_KEY=${NEXT_PUBLIC_TOSS_CLIENT_KEY}
ENV AUTH_API_INTERNAL_URL=${AUTH_API_INTERNAL_URL}
ENV PATIENTS_API_INTERNAL_URL=${PATIENTS_API_INTERNAL_URL}
ENV RECEPTION_API_INTERNAL_URL=${RECEPTION_API_INTERNAL_URL}
ENV BILLING_API_INTERNAL_URL=${BILLING_API_INTERNAL_URL}
ENV NOTIFICATION_API_INTERNAL_URL=${NOTIFICATION_API_INTERNAL_URL}

RUN npm run build

FROM node:24-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

COPY --from=build /app ./

EXPOSE 3001
CMD ["npm", "run", "start", "--", "-p", "3001", "-H", "0.0.0.0"]
